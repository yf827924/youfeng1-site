; ============================================================
;  Cloudflare R2 凭证配置
;  用法：把本文件复制成 r2_config.ini，填好后保存（不要提交到 git）
;  注意：r2_config.ini 已被 .gitignore 忽略，不会被 push 到公开仓库
; ============================================================

[r2]
; --- 1. Cloudflare 账号 ID ---
; 位置：Cloudflare Dashboard -> R2 -> 概览页右侧 "Account ID"
account_id =

; --- 2. R2 API Token（不是 Cloudflare 全局 API Key！）---
; 位置：R2 -> Manage R2 API Tokens -> Create API Token
;       权限选 "Object Read & Write"，可限定到 youfeng1-site 这个桶
;       Access Key ID 和 Secret Access Key 只在创建时显示一次，务必立刻记下
access_key_id =
secret_access_key =

; --- 3. 存储桶名称 ---
bucket = youfeng1-site

; --- 4. endpoint（一般不用填，脚本会按 account_id 自动拼）---
; 自动拼出来的形如：https://<account_id>.r2.cloudflarestorage.com
endpoint =
