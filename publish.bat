@echo off
REM ============================================================
REM  一键发布脚本  ——  改完网页/内容后，双击本文件即可上线
REM  用法：  publish.bat "本次更新的说明"   （说明可省略）
REM  前提：已按《发布指南》完成 GitHub 仓库创建 + SSH 公钥添加 + 首次推送
REM ============================================================
cd /d %~dp0

git add -A

if "%~1"=="" (
  set MSG=更新 %date% %time%
) else (
  set MSG=%~1
)

git commit -m "%MSG%" || echo [提示] 没有内容变更，跳过提交
git push

echo.
echo ============================================================
echo  发布流程已执行。若首次推送提示 "no upstream branch"，
echo  请先手动运行一次：  git push -u origin main
echo ============================================================
pause
